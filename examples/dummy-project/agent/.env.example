# Copy to agent/.env and fill in your provider. NEVER commit agent/.env.
# See the repo-root .env.example for the full set of supported variables.

# LLM provider (used by OpenHands, Codex, and self-hosted Claude Code)
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_SKIP_TLS_VERIFY=

# OpenHands settings
LLM_TIMEOUT="300"
LLM_TEMPERATURE="0.0"

# Laminar tracing (optional — set LMNR_PROJECT_API_KEY to enable, OpenHands only)
LMNR_BASE_URL=
LMNR_PROJECT_API_KEY=
LMNR_HTTP_PORT="8000"
